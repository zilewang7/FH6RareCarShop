<Window x:Class="FH6ItalianRarities.AutoPurchaseOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FH6 自动购买进度"
        Width="370" Height="280"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        Focusable="False" IsHitTestVisible="False"
        Foreground="#F3F7FA" FontSize="12"
        TextOptions.TextRenderingMode="Grayscale">
    <Border Background="#D91B2833" BorderBrush="#657DB8CC" BorderThickness="1"
            CornerRadius="12" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <RowDefinition Height="8" />
                <RowDefinition Height="40" />
                <RowDefinition Height="12" />
                <RowDefinition Height="48" />
                <RowDefinition Height="10" />
                <RowDefinition Height="16" />
                <RowDefinition Height="8" />
                <RowDefinition Height="36" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <TextBlock x:Name="OverlayElapsedText" DockPanel.Dock="Right" Text="00:00:00"
                           Foreground="#A9BEC9" VerticalAlignment="Center" />
                <TextBlock Text="FH6 · 自动购买" FontSize="14" FontWeight="SemiBold"
                           Foreground="#8DDCF0" VerticalAlignment="Center" />
            </DockPanel>
            <StackPanel Grid.Row="2">
                <TextBlock x:Name="OverlayVehicleText" FontSize="18" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="OverlayOriginalNameText" Foreground="#A9BEC9" FontSize="11"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="已执行购买轮次" Foreground="#A9BEC9" />
                    <TextBlock x:Name="OverlayCompletedText" Text="0 轮" FontSize="24"
                               FontWeight="SemiBold" />
                </StackPanel>
                <Border Grid.Column="1" Background="#45677D8B" Margin="0,3" />
                <StackPanel Grid.Column="2" Margin="18,0,0,0">
                    <TextBlock Text="目标数量" Foreground="#A9BEC9" />
                    <TextBlock x:Name="OverlayTargetText" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="OverlayTimingText" Grid.Row="6" Foreground="#A9BEC9" FontSize="11"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="OverlayStatusText" Grid.Row="8" Text="等待切回游戏…"
                       Foreground="#8DDCF0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
            <DockPanel Grid.Row="10" VerticalAlignment="Center">
                <TextBlock x:Name="OverlayFooterText" DockPanel.Dock="Right" Text="入库数量以游戏为准"
                           Foreground="#A9BEC9" FontSize="10" VerticalAlignment="Center" />
                <Border Background="#334AB9D4" BorderBrush="#658DDCF0" BorderThickness="1"
                        CornerRadius="5" Padding="9,4" HorizontalAlignment="Left">
                    <TextBlock x:Name="OverlayHotKeyText" Text="F8 · 全局停止" FontWeight="SemiBold" />
                </Border>
            </DockPanel>
        </Grid>
    </Border>
</Window>
