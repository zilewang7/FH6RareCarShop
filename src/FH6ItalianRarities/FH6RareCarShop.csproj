<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AssemblyName>FH6RareCarShop</AssemblyName>
    <RootNamespace>FH6ItalianRarities</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\FH6RareCarShop.ico</ApplicationIcon>
    <Version>2.0.2</Version>
    <Authors>FH6 Rare Car Shop Community Tool</Authors>
    <Description>Forza Horizon 6 multi-activity rare car shop selector</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\FH6RareCarShop.ico" />
    <ProjectReference Include="..\FH6ItalianRarities.Core\FH6RareCarShop.Core.csproj" />
  </ItemGroup>
</Project>
